{
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(make clean:*)",
      "Bash(docker compose down -v:*)",
      "Bash(alembic downgrade:*)",
      "Read(./.env*)",
      "Edit(./.env*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(launchctl kickstart:*)"
    ],
    "allow": [
      "Bash(grep -c:*)",
      "Bash(grep -q:*)",
      "Bash(cut -d= -f1:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
