      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30,40,50 8 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "0 0,10,20,30,40,50 9 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "0 0,10,20,30 10 * * 1-5"
            }
