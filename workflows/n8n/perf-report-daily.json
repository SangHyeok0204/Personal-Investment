      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 320]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30,40,50 8 * * 1"
            },
            {
              "field": "cronExpression",
              "expression": "0 0,10,20,30,40,50 9 * * 1"
            },
            {
              "field": "cronExpression",
              "expression": "0 0,10,20,30 10 * * 1"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "월요일 08:30~10:30 · 10분",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://collector:8100/perf-report/generate",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "scope",
              "value": "주간"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "주간 생성 요청 (월요일)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 560]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-stale",
              "leftValue": "={{ $json.sourceStale }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-late",
              "leftValue": "={{ $now.setZone('Asia/Seoul').hour }}",
              "rightValue": 10,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "10시 넘도록 소스 미갱신?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [820, 320]
    },
    {
      "parameters": {
        "message": "=[성과분석] 소스 워크북이 아직 안 왔습니다.\n\n오늘 {{ $json.today }} {{ $json.generatedAt }} 기준으로 보고서를 만들지 못했습니다.\n\n{{ $json.results.map(r => '· ' + r.label + ' — ' + r.status + ' / ' + r.reason).join('\\n') }}\n\n엑셀에서 '이상 포트폴리오 수익률.xlsx' 와 '05M72_port.xlsx' 를 열어 블룸버그 갱신 후 저장하면 다음 발화(10분 이내)에 자동으로 만들어집니다.",
