{
  "id": "daily-reports",
  "name": "주간가격 · 매크로 리포트 일간 생성",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30,40,50 8 * * 1-5"
