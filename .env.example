POSTGRES_DB=investment
POSTGRES_USER=investment_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://investment_user:change_me@postgres:5432/investment

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000

STORAGE_DIR=/app/storage

WORKER_POLL_INTERVAL_SECONDS=2

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change_me

# 내부 전용 API 인증 키. n8n·통합테스트가 POST /internal/* 호출 시 X-Internal-API-Key 헤더로 보낸다.
# 운영 시 반드시 임의의 강한 값으로 교체한다.
INTERNAL_API_KEY=change_me_internal

# 텔레그램 봇 (선택). https://my.telegram.org 에서 발급.
# 실제 값은 .env 에만 넣는다 — 이 파일은 git에 커밋되므로 절대 채우지 말 것.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# AI 사용량 모니터 업스트림 (Claude/Codex 계정별 사용률). /api/v1/ai-token-usage 프록시용.
AI_USAGE_MONITOR_BASE_URL=http://192.168.199.120:8002