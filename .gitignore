# Dependencies
node_modules/

# Next.js build output
.next/

# Python
__pycache__/
*.pyc
.venv*

# Environment (never commit real secrets)
.env

# Corporate root CA — copied into build context locally, never committed
apps/collector/somansa-root.crt

# Storage: keep folder structure, ignore uploaded/processed files
storage/raw/*
storage/processed/*
storage/trigger/*.json
!storage/**/.gitkeep

# Windows / WSL artifacts
*Zone.Identifier

# macOS
.DS_Store
