POSTGRES_DB=investment
POSTGRES_USER=investment_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://investment_user:change_me@postgres:5432/investment

NEXT_PUBLIC_API_BASE_URL=http://192.168.199.63:8000
INTERNAL_API_BASE_URL=http://api:8000

STORAGE_DIR=/app/storage

WORKER_POLL_INTERVAL_SECONDS=2

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change_me

# 키움증권 REST API 자격증명 (키움증권 홈페이지 → Open API → REST API 신청 후 발급받는다)
# 두 키가 비어 있으면 키움 동기화 작업은 validate_configuration 단계에서 깨끗하게 실패한다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 키움 REST API 기본 URL (실전투자). 모의투자 등 다른 도메인을 쓰면 여기서 교체한다.
KIWOOM_API_BASE_URL=https://api.kiwoom.com
# 실행 환경 표시: REAL(실전) 등. 코드가 참고하는 라벨일 뿐 URL 자체는 위에서 정한다.
KIWOOM_ENVIRONMENT=REAL

# 내부 전용 API 인증 키. n8n·통합테스트가 POST /internal/* 호출 시 X-Internal-API-Key 헤더로 보낸다.
# 운영 시 반드시 임의의 강한 값으로 교체한다.
INTERNAL_API_KEY=gDVEE0I3bmto07YEpNl9PyGzXViETnPHWxLtJg6Rw

# 텔레그램 봇 (선택). https://my.telegram.org 에서 발급.
# 실제 값은 .env 에만 넣는다 — 이 파일은 git에 커밋되므로 절대 채우지 말 것.
TELEGRAM_API_ID=
