tx:m-US-C a vc:Membership ;
    vc:company co:US-C ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F01 ; vc:belongsTo tx:F01 ;
    vc:role "후보: 유니버설은행" ;
    vc:points ( "2026년 2분기(10-Q) 순매출 247.66억 달러 중 순이자수익 171.25억(69.1%)·비이자수익 76.41억(30.9%), 계속영업이익 60.24억 달러. 부문별 매출·계속영업이익: Services 63.82억(25.8%)·25.97억(43.1%), Markets 70.07억(28.3%)·24.04억(39.9%), Banking 19.22억(7.8%)·3.51억(5.8%), Wealth 31.77억(12.8%)·5.83억(9.7%), USPB 45.21억(18.3%)·8.52억(14.1%), All Other 17.37억·-7.61억. 매출 1위는 Markets, 이익 1위는 Services로 단일 부문은 갈리지만 예금·대출 축(Services+USPB) 합산 109.03억(44.0%)·34.49억(57.3%)이 Markets+Banking 89.29억(36.1%)·27.55억(45.7%)을 매출·이익 모두 앞서 유니버설은행 후보. Services 평균예금 1조 170억 달러 등 총예금 1조 4,926억 대 장기차입 3,337억·단기차입 690억. Services 안에 Securities Services(수탁)가 섞여 있으나 별도 손익은 부문 주석에 없다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/831001/000083100126000045/R61.htm"^^xsd:anyURI ;
    vc:source tx:src .

