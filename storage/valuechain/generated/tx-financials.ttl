# ━━ F08 거래소·결제인프라 ━━

co:US-AXP a vc:Company ;
    rdfs:label "American Express Company" ;
    vc:ticker "AXP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US0258161092" .
tx:m-US-AXP a vc:Membership ;
    vc:company co:US-AXP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F08 ; vc:belongsTo tx:F08 ;
    vc:points ( "2026년 2분기 이자비용 차감 후 총수익 196.37억 달러 중 가맹점 할인수수료(discount revenue) 101.63억(51.8%), 순카드연회비 28.62억(14.6%), 서비스수수료 19.63억(10.0%)이고 순이자수익은 46.49억(23.7%)이다. 유형별 이익은 공시되지 않으나 비이자수익 149.88억에서 리워드·사업개발·회원서비스 직접비 87.55억을 뺀 62.3억이 순이자수익에서 대손충당 10.84억을 뺀 35.65억보다 크다. 부문 세전이익은 발급부문 USCS 20.65억·CS 9.70억·ICS 4.77억, 네트워크·가맹점 부문 GMNS 11.28억이다. 6월말 예금 1,569.7억 대 장단기 차입 590.5억(예금비중 72.7%)으로 수신 2,121.9억 달러 채권을 조달하며 신용위험을 자기 대차대조표로 진다. 매출·직접비 차감 기여 모두 결제수수료가 우위라 Chime 선례대로 결제 네트워크로 판정하되 예금조달 카드대출은 2차 노출로 기록한다. 폐쇄형 네트워크로 발급·매입·네트워크를 겸해 Visa·Mastercard의 개방형 카드망이나 가맹점 결제처리와 손익 구조가 다르므로 L3는 비운다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/4962/000000496226000322/R2.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-BILL a vc:Company ;
    rdfs:label "BILL Holdings Inc." ;
    vc:ticker "BILL" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US0900431000" .
tx:m-US-BILL a vc:Membership ;
    vc:company co:US-BILL ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F08 ; vc:belongsTo tx:F08 ;
    vc:role "후보: 기업 미지급금·지출결제" ;
    vc:points ( "BILL FY2026 10-K: 중소기업 미지급금·매출채권 자동화와 Divvy 법인카드 지출관리 플랫폼을 결제와 통합해 제공한다. FY2026 거래 수수료 12.112억 달러(총매출 16.532억의 73.3%)가 구독료 2.935억·고객자금 이자 1.484억을 상회하며, 거래액은 3,713억 달러다. 거래 수수료 내 Spend and Expense 6.756억, AP/AR 5.041억 달러로 두 역할이 모두 크다. 매출총이익 13.379억 달러(80.9%), 순손실 0.112억. 카드 매출채권 8.255억 달러에 대한 신용위험도 직접 부담하므로 순수 소프트웨어보다 결제·카드 거래와 위험 관리가 대표 역할이다. Corpay는 차량·연료 및 기업 지급결제, Payoneer는 국경간 수취·환전이 주력으로 계약·원가가 달라 BILL의 L3는 아직 후보. 회사의 카드 신용위험 및 손실: https://www.sec.gov/Archives/edgar/data/1786352/000162828026058238/bill-20260630.htm ; Corpay 비교: https://www.sec.gov/Archives/edgar/data/1175454/000117545426000050/cpay-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1786352/000162828026058238/bill-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

