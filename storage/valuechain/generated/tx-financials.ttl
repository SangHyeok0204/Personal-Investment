    vc:role "후보: 기업 보험중개" ;
    vc:points ( "2026년 2분기 매출 40.03억 달러 중 Brokerage 35.02억(87.5%), Risk Management(Gallagher Bassett 손해사정 TPA) 5.01억(12.5%). 세전이익은 Brokerage 6.04억 대 Risk Management 0.78억으로 Brokerage가 부문 합계의 89%(상반기 매출 89%·세전이익 93%). Brokerage 매출은 커미션 24.42억·수수료 7.38억·보충/조건부 커미션 2.32억 구성. 10-Q는 캡티브·풀 설립에 필요한 최소 규제자본 수준의 비중요 금액을 제외하면 순기준 인수위험을 부담하지 않는다고 명시." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/354190/000162828026053489/R74.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-AON a vc:Company ;
    rdfs:label "Aon plc" ;
    vc:ticker "AON" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "IE00BLP1HW54" .
