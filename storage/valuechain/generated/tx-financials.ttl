tx:m-US-NP a vc:Membership ;
    vc:company co:US-NP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F05 ; vc:belongsTo tx:F05 ;
    vc:role "후보: MGA 인수대행" ;
    vc:points ( "Neptune Insurance Holdings는 2025-10-01 NYSE 상장한 홍수보험 MGA로, 2025년 말 40개 캐파시티 제공자(8개 보험프로그램, 재보험사 32곳)가 인수위험과 청구처리를 전부 부담하며 10-K는 대차대조표 보험위험을 전혀 지지 않는다고 명시한다. FY2025 매출 1.596억 달러는 캐파시티 제공자가 지급하는 커미션 1.220억(76.5%)과 계약자 부담 정책수수료 0.375억(23.5%)로 구성되고 순이익 0.374억, 조정 EBITDA 0.950억, 유효보험료 3.702억이다. 위험 인수 없이 인수대행·판매 수수료가 전부이므로 보험중개·대리로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/2067129/000206712926000007/nyse-20251231.htm"^^xsd:anyURI ;
    vc:source tx:src .

