    vc:points ( "2026년 2분기 10-Q 기준 보고부문은 Risk Capital·Human Capital 2개. 2분기 매출 42.46억 달러 중 Risk Capital 30.06억(71%), Human Capital 12.44억(29%); 부문 영업이익은 Risk Capital 9.16억 대 Human Capital 1.67억으로 Risk Capital이 85%. 서비스라인별로는 Commercial Risk 22.95억(54%), Reinsurance 7.11억(17%), Health 8.18억(19%), Wealth 4.26억(10%). 상반기도 Risk Capital 매출 70%·영업이익 79%로 기업 위험·재보험 중개가 우위. 중개·자문 수수료 구조로 인수위험 부담 문구 없음." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/315293/000162828026050610/R75.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-ARX a vc:Company ;
    rdfs:label "Accelerant Holdings" ;
    vc:ticker "ARX" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
