    vc:points ( "PayPal 2026년 상반기 10-Q: 소비자 PayPal·Venmo 계정과 Braintree 가맹점 처리 등을 연결해 결제거래와 환전·즉시인출 수수료를 받는다. 상반기 거래 매출 153.33억 달러(순매출 170.35억의 90.0%), 기타 부가서비스 17.02억이다. 거래원가 85.50억 달러, 거래·신용 손실 7.75억, 영업이익 29.15억(영업이익률 17.1%). 이자·대출 위험보다 결제량과 결제수단 믹스가 주 수익·원가 동인이다. Block도 소비자 Cash App과 가맹점 Square를 병행하지만 2026년 상반기 금융솔루션 매출 27.04억, 신용손실 10.86억 달러로 대출 위험이 현저하게 커 동일 L3 확정은 유보한다. Block 비교: https://www.sec.gov/Archives/edgar/data/1512673/000162828026053368/xyz-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1633917/000163391726000082/pypl-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-RELY a vc:Company ;
    rdfs:label "Remitly Global Inc." ;
    vc:ticker "RELY" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US75960P1049" .
tx:m-US-RELY a vc:Membership ;
    vc:company co:US-RELY ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F08 ; vc:belongsTo tx:F08 ;
    vc:role "소비자 국경간 송금" ;
    vc:points ( "Remitly 2026년 상반기 10-Q는 글로벌 송금이 매출의 대부분이며 송금자의 건별 수수료와 FX 스프레드로 수익을 얻는다고 명시한다. 상반기 매출 9.480억 달러, 거래비용 3.061억 달러(매출의 32.3%), 송금액 456억 달러다. 수취인 지급기관 수수료·부정거래 손실·고객획득비가 손익의 핵심이다. Western Union 2026년 2분기 공시에서도 Consumer Money Transfer가 매출 8.661억/연결 10.132억 달러(85.5%), 부문 영업이익 1.257억 달러이며 거래액·대리점 수수료·FX 스프레드로 돈을 번다. 두 회사는 개인의 송금 완료가 경제적 산출물이라는 점이 같아 L3 확정. 다만 Remitly는 디지털 고객획득, WU는 오프라인 대리점 비중이 커 마진율 자체를 동일하게 가정하지 않는다. 비교: https://www.sec.gov/Archives/edgar/data/1365135/000119312526326355/wu-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1782170/000162828026053424/rely-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

