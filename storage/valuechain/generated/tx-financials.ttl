# ━━ F05 보험중개·대리 ━━

co:US-AJG a vc:Company ;
    rdfs:label "Arthur J. Gallagher & Co." ;
    vc:ticker "AJG" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
