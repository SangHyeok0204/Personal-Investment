co:US-DLO a vc:Company ;
    rdfs:label "DLocal Limited" ;
    vc:ticker "DLO" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "KYG290181018" .
tx:m-US-DLO a vc:Membership ;
    vc:company co:US-DLO ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F08 ; vc:belongsTo tx:F08 ;
    vc:role "후보: 글로벌 가맹점의 현지수납·지급 연결" ;
    vc:points ( "dLocal 2026년 상반기 6-K 재무제표는 국제 가맹점의 현지 결제수단을 통한 수납과 현지 지급의 결제처리만을 매출 원천으로 제시한다. 결제처리 매출 7.355억 달러, 총이익 2.458억 달러(총이익률 33.4%). 2분기 결제액은 177억 달러(같은 6-K의 공식 실적 자료: https://www.sec.gov/Archives/edgar/data/1846832/000184683226000031/ex_991-dlocalxearningsxres.htm). 2026년 1분기 공식 자료에서 수납(pay-in) 거래액 72%, 지급 28%, 국경간 45%, 동일국가·동일통화 55%이므로 회사 이름만으로 국경간 송금에 한정할 수 없다. Remitly는 주로 개인 송금자에게 수수료와 환율 스프레드를 받아 고객·채널·손실비용이 다르다. 최신 분기에서 수납·지급/국경간·현지별 총이익은 공개되지 않아 L3는 후보. 사업모델: https://www.sec.gov/Archives/edgar/data/1846832/000207097926000113/dlo-20251231.htm ; 1분기 믹스: https://www.sec.gov/Archives/edgar/data/1846832/000184683226000019/ex994dlocal1q26ep.htm ; Remitly 비교: https://www.sec.gov/Archives/edgar/data/1782170/000162828026053424/rely-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1846832/000184683226000031/dlo-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-EEFT a vc:Company ;
    rdfs:label "Euronet Worldwide Inc." ;
    vc:ticker "EEFT" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
