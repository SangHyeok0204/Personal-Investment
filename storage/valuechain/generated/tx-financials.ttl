tx:m-US-PAYO a vc:Membership ;
    vc:company co:US-PAYO ; vc:sector tx:Sector ;
    vc:primaryCategory tx:F08 ; vc:belongsTo tx:F08 ;
    vc:role "후보: 중소기업 국경간 수취·지급" ;
    vc:points ( "Payoneer 2026년 상반기 10-Q: 해외 온라인 판매·B2B 중소기업의 대금 수취, 인출, 환전, Checkout 및 카드 지급을 처리한다. 상반기 거래액 464.49억 달러, 고객 계약 매출 4.284억 달러(총매출 5.359억의 79.9%), 고객 잔액 이자 1.036억(19.3%), 대출성 선급금 수익 0.038억(0.7%)이다. 거래원가 0.729억(총매출의 13.6%), 영업이익 0.470억(8.8%). 거래 수수료가 주 수익이어서 이자율·선급금 위험이 있어도 비은행 신용공급보다 결제 인프라가 적합하다. Flywire 역시 국경간 수납을 하지만 교육·의료·여행기관 대상 거래 수수료 81.8%와 결제 처리 원가 42.8%로 고객·과금구조가 달라 L3 동일군을 확정하지 않는다. Flywire 비교: https://www.sec.gov/Archives/edgar/data/1580560/000158056026000016/flyw-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1845815/000110465926091988/payo-20260630x10q.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-PAYP a vc:Company ;
