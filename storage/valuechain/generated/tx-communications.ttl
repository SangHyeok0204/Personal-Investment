    vc:isin "US77543R1023" .
tx:m-US-ROKU a vc:Membership ;
    vc:company co:US-ROKU ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: CTV 광고·배급 플랫폼" ;
    vc:points ( "2026년 2분기 순매출 13.55억 달러 중 플랫폼 12.21억(90.1%), 기기 1.34억(9.9%)이고 총이익 6.74억 중 플랫폼이 6.47억(96.0%)로 기기(0.27억)는 이익 기여가 거의 없다. 플랫폼 매출은 광고 6.73억(총매출의 49.7%, 플랫폼의 55.1%)과 구독 5.48억(40.5%)으로 나뉘며, 구독은 프리미엄 구독 판매·자체 구독서비스와 콘텐츠 파트너 구독 수익배분·리모컨 브랜드 버튼 판매를 포함한다. 자체 OS 홈화면과 Roku Channel의 광고 지면 판매가 최대 수익원이고 콘텐츠 IP 소유가 아니라 배급 계층이므로 광고·소셜플랫폼으로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1428439/000162828026054335/roku-20260630.htm"^^xsd:anyURI ;
