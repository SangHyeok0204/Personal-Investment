co:US-JOYY a vc:Company ;
    rdfs:label "JOYY Inc." ;
    vc:ticker "JOYY" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US46591M1099" .
tx:m-US-JOYY a vc:Membership ;
    vc:company co:US-JOYY ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: 소셜 라이브·가상선물" ;
    vc:points ( "JOYY 2026년 2분기 공식 실적: 소셜 엔터테인먼트 매출 4.227억 달러/총매출 5.908억 달러(71.6%)와 매출총이익 1.582억 달러/총이익 2.016억 달러(78.5%)가 대표 사업이다. 라이브스트리밍 매출만 4.026억 달러로 68.2%이고, BIGO Ads 매출은 1.337억 달러(22.6%), Shopline은 0.344억 달러(5.8%). 시청자 가상선물·유료 상호작용, 창작자 수익배분·콘텐츠 비용에 의해 손익이 결정되므로 자체 콘텐츠 IP의 제작·배급이나 단순 광고기술보다 소셜플랫폼에 둔다. 비교기업 HUYA는 2026년 2분기 라이브 매출 11.015억 위안/총 17.393억 위안(63.3%)이고 게임 관련 서비스·광고도 크며 창작자 수익배분이 주요 원가다. JOYY의 글로벌 종합 소셜라이브와 HUYA의 게임방송 중심 차이가 있으나 세부 콘텐츠별 영업이익이 없어 L3는 후보로 둔다. HUYA 공시: https://www.sec.gov/Archives/edgar/data/1728190/000110465926094381/tm2622963d1_ex99-1.htm" ) ;
    vc:url "https://ir.joyy.com/node/10646"^^xsd:anyURI ;
    vc:source tx:src .

