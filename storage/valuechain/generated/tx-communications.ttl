tx:m-US-WB a vc:Membership ;
    vc:company co:US-WB ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: 소셜 피드 광고" ;
    vc:points ( "Weibo 2026년 2분기 6-K: 공개형 소셜미디어 피드·검색·콘텐츠 이용자를 모아 광고주에 마케팅 노출을 판매한다. 광고·마케팅 매출 $380.974m/총 $453.826m(84.0%), 부가서비스 $72.852m; 연결 영업이익 $118.9m, 영업이익률 26%. 광고주 업종별 수요와 광고 제작비·마케팅비 변화가 손익 동인이다. Meta도 소셜앱 이용자에게 노출되는 광고가 매출·이익의 주력이지만 Feed/Stories/Reels별 수익화가 달라 세부 채널을 따로 본다. Weibo는 피드·검색·동영상 광고별 매출·이익을 분리하지 않으므로 소셜 피드 광고는 L3 후보로만 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1595761/000110465926098504/tm2623262d1_ex99-1.htm"^^xsd:anyURI ;
    vc:source tx:src .

