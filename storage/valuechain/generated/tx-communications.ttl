    vc:primaryCategory tx:C00 ; vc:belongsTo tx:C00 ;
    vc:points ( "IMAX의 2026년 2분기 10-Q에서 상반기 Technology Products and Services가 매출 1.13억 달러로 61.4%, 매출총이익 0.66억 달러로 60.6%를 차지한다(시스템 판매 20.4%, 흥행수입 연동 시스템 임대 19.8%, 유지보수 18.0%). Content Solutions(35.9%)의 DMR 수수료와 함께 수익이 IMAX 포맷 흥행성적에 연동되지만 극장 영사 시스템·포맷 플랫폼을 담는 L2가 없어 통신·미디어 L1만 기록한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/921582/000162828026049300/R34.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-XNET a vc:Company ;
    rdfs:label "Xunlei Limited" ;
    vc:ticker "XNET" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
