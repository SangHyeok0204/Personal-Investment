co:US-RUM a vc:Company ;
    rdfs:label "Rumble Inc." ;
    vc:ticker "RUM" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US78137L1052" .
tx:m-US-RUM a vc:Membership ;
    vc:company co:US-RUM ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:points ( "2026년 2분기 10-Q 매출 4,037만 달러 중 Audience Monetization(Rumble 플랫폼 광고·구독·라이선스·팁) 2,706만 달러 67.0%, Other Initiatives 1,330만 달러 33.0%이며 후자에 6월 17일 인수한 Northern Data의 클라우드·코로케이션 1,010만 달러(25.0%)가 포함. Audience Monetization 증가는 광고 590만 달러가 주도하고 Tether 광고계약(연 5,000만 달러)에서 2분기 554만 달러를 인식해 광고 지면 판매가 대표 수익원. 부문 손익은 미공시(영업손실 7,078만 달러). 인수 후 가정 재무정보상 Northern Data 인프라 매출이 기존 Rumble보다 크므로 3분기부터 디지털·컴퓨팅 > 클라우드·연산서비스로 전환될 가능성을 기록." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1830081/000121390026087311/ea0301267-10q_rumgroup.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-SNAP a vc:Company ;
    rdfs:label "Snap Inc." ;
    vc:ticker "SNAP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US83304A1060" .
tx:m-US-SNAP a vc:Membership ;
    vc:company co:US-SNAP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: 메신저·증강현실 광고" ;
    vc:points ( "Snap 2026년 2분기 10-Q: Snapchat의 Snap Ads·AR Ads를 노출 수 또는 단기 고정수수료로 판매한다. 광고 매출 12.82522억/전체 15.98993억 달러(80.2%), Snapchat+ 등 주로 구독인 기타 매출 3.16471억 달러(19.8%). 분기 매출총이익 약 9.31108억 달러, 영업손실 1.70721억 달러다. Pinterest의 시각 탐색 광고, Reddit의 대화 커뮤니티 광고와 고객 접점·AR 제작 및 콘텐츠 배분 비용이 다르다. 그러나 Snap Ads/AR Ads 및 구독 각각의 이익은 미공시여서 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1564408/000156440826000052/snap-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-TTD a vc:Company ;
    rdfs:label "The Trade Desk Inc." ;
    vc:ticker "TTD" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US88339J1051" .
tx:m-US-TTD a vc:Membership ;
    vc:company co:US-TTD ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: 광고주측 디지털 매체매입 플랫폼" ;
    vc:points ( "The Trade Desk 2026년 2분기 10-Q: 광고주·대행사가 제3자 매체의 광고 인벤토리를 여러 채널에서 구매·최적화하도록 DSP를 제공한다. 회사는 광고기술 플랫폼 단일 영업부문이며 매체공급자에게 지급한 금액을 차감한 순액으로 매출을 인식한다. 분기 매출 7.15057억 달러, 영업이익 1.01577억 달러(14.2%)이고 gross billings와 회계상 매출을 구분해야 한다. Yelp는 자사 지역 검색·리뷰에서 업체 광고를 직접 노출하고 CPC를 받으므로 같은 광고 L2 안에서도 매체 소유와 구매대행의 원가·계약이 다르다. 채널별 수익·이익이 없어 광고주측 매체매입 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1671933/000167193326000086/ttd-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-U a vc:Company ;
    rdfs:label "Unity Software Inc." ;
    vc:ticker "U" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
