# ━━ C06 통신 API·메시징 인프라 ━━

co:US-TWLO a vc:Company ;
    rdfs:label "Twilio Inc." ;
    vc:ticker "TWLO" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US90138F1021" .
tx:m-US-TWLO a vc:Membership ;
    vc:company co:US-TWLO ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C06 ; vc:belongsTo tx:C06 ;
    vc:points ( "2026년 2분기 기업 고객이 자사 앱에 문자·음성·이메일 통신을 삽입하는 API와 고객데이터 앱을 제공한다. 분기 매출 14.991억달러의 75%가 메시지 건수·통화시간 등 사용량 과금이고 25%가 비사용량 과금이다. 분기 원가 7.732억달러(매출의 약 51.6%)의 주된 항목은 망사업자에 지급하는 메시지·통화량 연동비다. 따라서 자체 가입자 회선 운영이나 기업용 앱 구독과 별개로 통신 접근 API를 제공하는 역할이다. Braze는 브랜드의 고객 참여 업무 앱 구독이며 제3자 메시지 비용은 일부 원가에 불과하다. Twilio는 최신 공시에서 메시지·음성·고객데이터 앱별 매출·이익을 분리하지 않아 L3는 보류한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1447669/000144766926000092/twlo-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

