    vc:primaryCategory tx:C08 ; vc:belongsTo tx:C08 ;
    vc:role "후보: 검색광고" ;
    vc:points ( "Alphabet 2026년 2분기 10-Q: Google 광고 매출 816.29억/총 1,197.96억 달러(68.1%), 그중 Search & other 632.71억 달러(광고의 77.5%, 총매출의 52.8%)다. Google Services 영업이익 395.44억 달러는 Google Cloud 88.14억 달러보다 크며 광고가 Services 매출의 86.3%다. 검색 클릭·광고단가와 트래픽 확보비(TAC)가 핵심 동인이다. AppLovin의 제3자 모바일 앱 광고중개와 달리 자사 검색 의도 광고가 주력이므로 검색광고 L3가 의미 있지만 검색 단독 영업이익은 미공시라 후보로 둔다. GOOGL·GOOG는 Alphabet의 서로 다른 주식종류로 동일 사업 경로를 공유한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1652044/000165204426000071/goog-20260630.htm"^^xsd:anyURI ;
