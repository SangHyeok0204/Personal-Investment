tx:m-US-XNET a vc:Membership ;
    vc:company co:US-XNET ; vc:sector tx:Sector ;
    vc:primaryCategory tx:C00 ; vc:belongsTo tx:C00 ;
    vc:points ( "Xunlei 2026년 2분기 6-K: 2026년 3월 Shenzhen Onething 지분 처분으로 과거 분산 클라우드 사업은 중단사업이다. 계속사업 매출 1.027억달러 중 해외 오디오 라이브·Hupu 광고 등이 든 live-streaming/other 0.582억(56.7%), 다운로드 가속·회원 서비스 구독 0.445억(43.3%). 총이익 0.573억(55.8%), 영업손실 0.048억달러. 오디오 라이브 수익배분 비용이 늘어 연결 마진이 하락했으나 구독과 Hupu 광고가 총이익 증가의 원인이다. JOYY도 창작자 라이브 수익배분을 부담하지만 Xunlei는 디지털 구독·스포츠매체 광고가 커서 라이브/광고/구독 중 대표 L2와 동종 L3를 제품별 손익 없이 결정하지 않는다. 현재 매출 과반이 사회적 라이브·광고라 L1만 통신·미디어로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1510593/000110465926095490/tm2623122d1_ex99-1.htm"^^xsd:anyURI ;
    vc:source tx:src .
