tx:m-US-HNGE a vc:Membership ;
    vc:company co:US-HNGE ; vc:sector tx:Sector ;
    vc:primaryCategory tx:H09 ; vc:belongsTo tx:H09 ;
    vc:role "후보: 디지털 근골격계 치료" ;
    vc:points ( "Hinge Health 2026년 2분기 10-Q: 근골격계 통증을 중심으로 AI 동작 분석, 웨어러블, 물리치료사·의료진이 결합된 치료 프로그램을 자가보험 고용주 등에 제공한다. 회원의 첫 청구 가능 활동 이후 연간 플랫폼비와 치료 세션·참여 기반 수수료를 받으며, 분기 매출 2.128억 달러, 매출총이익 1.839억 달러(86.4%), 영업이익 0.404억 달러(19.0%). 원가에 치료팀 인건비, 기기, 기술 지원이 포함돼 범용 SaaS 라이선스와 구별된다. 직접 비교기업 Omada는 근골격계 물리치료를 포함하지만 심혈관·대사질환까지 취급하며 2026년 2분기 매출총이익률 73%; 양사 모두 치료팀·기기비용이 동인이다. Hinge는 편두통·수술 지원도 확대 중이며 질환별 매출·이익을 나누지 않아 L3는 후보. 비교자료: https://www.sec.gov/Archives/edgar/data/1611115/000162828026054840/omda-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1673743/000162828026054327/hnge-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

