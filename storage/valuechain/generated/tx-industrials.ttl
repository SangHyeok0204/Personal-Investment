# ━━ I17 화물 중개·매칭 플랫폼 ━━

co:US-YMM a vc:Company ;
    rdfs:label "Full Truck Alliance Co. Ltd." ;
    vc:ticker "YMM" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US35969L1089" .
tx:m-US-YMM a vc:Membership ;
    vc:company co:US-YMM ; vc:sector tx:Sector ;
    vc:primaryCategory tx:I17 ; vc:belongsTo tx:I17 ;
    vc:points ( "Full Truck Alliance 2026년 2분기 6-K: 총매출 33.816억 위안 중 화물 매칭 30.126억(89.1%); 그 안에서 트럭 운송 거래서비스 17.664억(52.2% of total), 화물중개 9.954억, 화물게시 2.508억이다. 2025년 20-F에 따르면 거래 수수료는 화주와 트럭기사가 합의할 때 인식하고, 회사는 실제 화물운송을 수행하지 않는 대리인이다. 2026년 2분기 원가 9.259억 중 세금·관련비용 순액 7.434억으로 매칭/중개 모델의 손익이 운송원가보다 거래량·수수료·세금 구조에 좌우된다. 금융 등 부가서비스 매출은 3.690억(10.9%)이고 신용손실충당 0.720억. C.H. Robinson은 같은 기간 운송·물류 수익 45.248억 달러를 운송기간에 인식하고 구입운송비 38.284억 달러를 부담하므로 주계약과 원가가 다르다. 트럭 화물이라는 수단만으로 L3를 만들지 않고 보류한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1838413/000119312526356976/d240729dex991.htm"^^xsd:anyURI ;
    vc:source tx:src .

# ━━ I18 승객·배달 매칭 플랫폼 ━━

co:US-CART a vc:Company ;
    rdfs:label "Maplebear Inc." ;
    vc:ticker "CART" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US5653941030" .
tx:m-US-CART a vc:Membership ;
    vc:company co:US-CART ; vc:sector tx:Sector ;
    vc:primaryCategory tx:I18 ; vc:belongsTo tx:I18 ;
    vc:role "후보: 음식·식료품 배달 중개" ;
    vc:points ( "Maplebear(Instacart)의 2026년 2분기 10-Q는 단일 부문이며 매출 10.43억 달러 중 거래 매출 7.46억(71.5%), 광고·기타 2.97억(28.5%)이고 상반기도 거래 71.7%다. 8-K 보도자료 기준 GTV 103.51억 달러·주문 9,030만 건이며 거래 매출은 GTV의 7.2%, 광고·기타는 2.9%다. FY2025 10-K 회계정책은 회사가 상품 판매에서 소매업체의 대리인, 쇼퍼 이행서비스 조달에서 이용자의 대리인이며 소매업체 상품대금과 쇼퍼 지급액을 뺀 순액을 매출로 인식한다고 명시하고 매출원가에 쇼퍼 보수를 포함하지 않는다. 2분기 매출총이익 7.51억(72%), 조정 EBITDA 3.13억 달러. 광고와 거래 매출의 이익 분리는 공시되지 않아 광고 L2 전환 근거는 없다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1579091/000157909126000042/cart-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-DASH a vc:Company ;
    rdfs:label "DoorDash Inc." ;
    vc:ticker "DASH" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US25809K1051" .
tx:m-US-DASH a vc:Membership ;
    vc:company co:US-DASH ; vc:sector tx:Sector ;
    vc:primaryCategory tx:I18 ; vc:belongsTo tx:I18 ;
    vc:role "후보: 음식·식료품 배달 중개" ;
    vc:points ( "2026년 2분기 10-Q: 단일 보고부문, 매출 44.54억 달러(상반기 84.90억, 미국 65.61억·해외 19.29억). 승차 호출 사업이 없고 전량이 DoorDash·Wolt·Deliveroo 마켓플레이스 배달 중개와 상인 서비스이므로 배달 중개가 대표. 2026년 2분기 8-K 실적자료: Marketplace GOV 330.78억 달러·주문 9.7억 건·Net Revenue Margin 13.5%·조정 EBITDA 9.14억. FY2025 10-K 수익인식: 주문 중개는 상인의 대리인, 배달 중개는 소비자의 대리인으로 판단해 소비자 수취액에서 상인·Dasher 지급액을 뺀 순액으로 매출 인식. Dasher는 마켓플레이스를 이용하는 독립계약자." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1792789/000179278926000050/dash-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-GRAB a vc:Company ;
