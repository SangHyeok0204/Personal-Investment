# ━━ I03 산업용 레이저·광원 ━━

co:US-IPGP a vc:Company ;
    rdfs:label "IPG Photonics Corporation" ;
    vc:ticker "IPGP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
