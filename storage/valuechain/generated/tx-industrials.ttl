co:US-REZI a vc:Company ;
    rdfs:label "Resideo Technologies Inc." ;
    vc:ticker "REZI" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US76118Y1047" .
tx:m-US-REZI a vc:Membership ;
    vc:company co:US-REZI ; vc:sector tx:Sector ;
    vc:primaryCategory tx:I00 ; vc:belongsTo tx:I00 ;
    vc:points ( "2026년 2분기(7월 4일 종료) 10-Q 보고부문 기준 매출 19.81억 달러 중 ADI Global Distribution 12.86억(64.9%), Products & Solutions 6.95억(35.1%)이나 부문 영업이익은 P&S 1.38억(68.3%) 대 ADI 0.64억(31.7%)로 선두가 갈린다. 다만 ADI 분리(Resideo 2주당 ADIG 1주, 기준일 7월 20일)가 2026년 8월 초 완료되어 8-K 보도자료(8월 4일)에서 잔존 회사를 주거용 제어·감지 솔루션(Honeywell Home·First Alert·BRK) 전업 건물기술 회사로 정의하므로 P&S 기준으로 분류한다. P&S는 설치업체에 온도조절·보안·생명안전 기기를 공급하며 구독 비중이 낮아 L2 정의 확장 여부는 3분기 10-Q 후 재확인한다. 2026년 8월 ADI 유통 분리 후 잔존 Products & Solutions는 온도조절기·보안 센서·급수 제어 등 건물 제어 하드웨어 판매가 중심이라 클라우드 구독형 플랫폼 L2보다 산업재·건설(자동화·계측·로봇 또는 공조·열관리장비)에 가깝고, 분리 후 첫 10-Q(2026년 3분기) 공시 전에는 L2를 비운다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1740332/000174033226000025/rezi-20260704.htm"^^xsd:anyURI ;
    vc:source tx:src .

