    vc:isin "US90138A1034" .
tx:m-US-VNET a vc:Membership ;
    vc:company co:US-VNET ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R01 ; vc:belongsTo tx:R01 ;
    vc:points ( "VNET 2026년 2분기 공식 실적: 데이터센터(IDC) 매출 RMB21.5억/총 RMB27.8억(약 77%), 도매 IDC RMB11.0억, 소매 IDC RMB10.5억, 비IDC 클라우드·VPN 등 RMB6.284억. IDC는 고객 서버용 맞춤 데이터센터 시설·캐비닛과 전력·연결 서비스를 제공한다. 연결 영업이익 RMB2.2925억이나 센터 모델별 손익은 미공시이며 확장에 따른 감가상각으로 총이익률이 18.2%로 하락했다. 2025년 20-F에서 소매 캐비닛 49,863개 중 자체구축 46,146개, 제휴 3,717개로 시설 투자·공실·전력비가 핵심이라고 확인된다. Equinix의 2026년 상반기 코로케이션·상호연결 등 반복매출 모델과 비교하면 같은 데이터센터 L2이나, VNET은 도매·소매 매출이 근접하고 모델별 수익성이 없어 고밀도 도매형/다고객 소매형 L3를 고정하지 않는다." ) ;
    vc:url "https://ir.vnet.com/news-releases/news-release-details/vnet-reports-unaudited-second-quarter-2026-financial-results"^^xsd:anyURI ;
    vc:source tx:src .

