# ━━ R03 기존주택 직접매입·재판매 ━━

co:US-OPEN a vc:Company ;
    rdfs:label "Opendoor Technologies Inc" ;
    vc:ticker "OPEN" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US6837121036" .
tx:m-US-OPEN a vc:Membership ;
    vc:company co:US-OPEN ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R03 ; vc:belongsTo tx:R03 ;
    vc:points ( "Opendoor 2026년 2분기 10-Q: 기업이 주택 소유자에게서 기존주택을 직접 매입하여 자체 재고로 보유·수리한 뒤 구매자에게 소유권을 이전할 때 주택 판매대금을 총액 매출로 인식한다. 분기 매출 8.83억 달러, 매출원가 7.97억, 매출총이익 0.86억(9.7%), 영업손실 1.44억 달러. 판매주택 2,339채이며 기말 부동산 재고 18.45억 달러와 담보부 재고금융 차입이 있다. 중개수수료를 버는 KE Holdings, 매물정보·광고를 파는 Zillow/CoStar와 달리 주택가격·재고보유·수리·금융 위험을 직접 부담한다. 신축 개발·분양도 아니므로 별도 기존주택 직접매입·재판매 L2를 둔다. 수리 정도·주택유형별 마진이 분리되지 않아 L3는 비운다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1801169/000180116926000021/open-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

# ━━ R05 부동산 중개·정보 ━━

co:US-BEKE a vc:Company ;
    rdfs:label "KE Holdings Inc" ;
    vc:ticker "BEKE" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US4824971042" .
tx:m-US-BEKE a vc:Membership ;
    vc:company co:US-BEKE ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R05 ; vc:belongsTo tx:R05 ;
    vc:role "후보: 주거 거래 중개" ;
    vc:points ( "KE Holdings 2026년 상반기 공식 중간보고서: 기존주택 거래서비스 매출 131.55억 위안, 신축주택 거래서비스 140.34억 위안으로 합계 271.89억/전체 434.31억(62.6%)이다. 두 거래서비스의 중개인 보수 차감 후 기여는 각각 57.69억·38.84억 위안으로 합계 96.53억 위안이다. 임대서비스 98.46억·리모델링/가구 55.30억도 크지만 거래중개 기여가 더 크다. 연결 영업이익은 42.99억 위안. Zillow는 주거 매물·중개인 광고/연결 매출 중심이고 직접 중개 인건비·수수료 부담이 달라 같은 L2 안에서 주거 거래 중개를 L3 후보로 본다. 기존·신축 거래, 임대관리의 장기 손익 구성은 계속 관찰한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1809587/000110465926105898/tm2624957d1_ex99-1.pdf"^^xsd:anyURI ;
    vc:source tx:src .

co:US-CIGI a vc:Company ;
    rdfs:label "Colliers International Group Inc." ;
    vc:ticker "CIGI" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "CA1946931070" .
tx:m-US-CIGI a vc:Membership ;
    vc:company co:US-CIGI ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R05 ; vc:belongsTo tx:R05 ;
    vc:role "후보: 상업 중개" ;
    vc:points ( "2026년 2분기 매출 15.73억 달러: Real Estate Services 9.97억(63.4%), Engineering 4.28억(27.2%), Investment Management 1.47억(9.4%). 조정 EBITDA는 RES 1.06억(부문 합계의 51.1%), Engineering 0.52억, IM 0.49억으로 RES가 매출·이익 모두 선두. RES 내부 서비스라인은 Leasing 3.35억+Capital Markets 2.62억=5.97억(회사 매출 38.0%)이 자산관리 1.44억·감정자문 1.30억·프로젝트관리 0.94억(합 3.68억)을 앞서 중개가 대표. Engineering(Ayesa 인수)은 산업재·건설 성격의 2차 노출." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/913353/000117184326005248/exh_991.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-COMP a vc:Company ;
    rdfs:label "Compass Inc." ;
    vc:ticker "COMP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US20464U1007" .
tx:m-US-COMP a vc:Membership ;
    vc:company co:US-COMP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R05 ; vc:belongsTo tx:R05 ;
    vc:role "주거용 거래 중개" ;
    vc:points ( "Compass 2026년 2분기 10-Q: Anywhere 인수 후 Brokerage 매출 39.60억 달러는 총매출 43.06억 달러의 92.0%이고, Franchise 1.35억·Integrated Services 2.11억 달러가 나머지다. Brokerage 매출 대부분인 총중개수수료 39.47억 달러는 주택 거래 종결 시 인식하며, 중개인 수수료 등 관련 비용 32.54억 달러는 Brokerage 매출의 약 82.2%다. AGNT(구 eXp)의 2026년 2분기도 거래 중개 매출 14.50억 달러와 중개인 관련 비용 13.51억 달러(93.2%)로 거래 건수·거래액·중개인 배분율에 연동되는 동일한 역할이다. Compass는 프랜차이즈·부대서비스도 보유하지만 주력은 직영 주거 중개다. 따라서 부동산 광고·매물 정보료가 주력인 회사와 구분해 주거용 거래 중개 L3를 확정한다. AGNT 비교 공시: https://www.sec.gov/Archives/edgar/data/1495932/000110465926090337/agnt-20260630x10q.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1563190/000156319026000143/comp-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-CSGP a vc:Company ;
    rdfs:label "CoStar Group Inc." ;
    vc:ticker "CSGP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US22160N1090" .
tx:m-US-CSGP a vc:Membership ;
    vc:company co:US-CSGP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:R05 ; vc:belongsTo tx:R05 ;
    vc:role "후보: 상업용 부동산 정보·매물 구독" ;
    vc:points ( "CoStar Group 2026년 2분기 10-Q: 상업용 부동산 정보·매물·분석 부문 매출 4.81억/전체 9.25억 달러(52.0%), 주거용 매물광고 부문 4.44억(48.0%)이다. 상업 부문 조정 EBITDA 1.72억 달러에 비해 주거 부문은 0.12억 달러여서 이익 중심은 상업용 정보·매물이다. 상업 부문의 CoStar 정보 구독 매출은 3.37억 달러, LoopNet 매물광고 0.87억 달러다. Zillow는 주거용 Residential 60.2%이고 중개인 연결·임대 광고가 중심이라 고객과 계약이 다르다. 다만 CoStar는 주거 부문도 거의 절반이고 상업 내 정보/광고의 독립 이익이 없어 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1057352/000105735226000066/csgp-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-NMRK a vc:Company ;
    rdfs:label "Newmark Group Inc." ;
    vc:ticker "NMRK" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US65158N1028" .
