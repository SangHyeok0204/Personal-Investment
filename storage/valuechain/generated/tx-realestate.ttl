    vc:primaryCategory tx:R05 ; vc:belongsTo tx:R05 ;
    vc:role "후보: 상업 중개" ;
    vc:points ( "2026년 2분기 10-Q 매출 8.884억 달러 중 Management services, servicing fees and other 3.512억(39.5%), Leasing and other commissions 2.780억(31.3%), Capital markets 2.592억(29.2%). 임대·자본시장 중개 커미션 합계 5.372억(60.5%)이 관리·서비싱 수탁을 명확히 앞서 L2는 부동산 중개·정보다. 단일 보고부문이라 서비스라인별 이익은 공시하지 않으며 Colliers 선례에 따라 상업 중개를 L3 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1690680/000162828026054877/R64.htm"^^xsd:anyURI ;
    vc:source tx:src .

