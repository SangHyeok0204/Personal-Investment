    vc:primaryCategory tx:T02 ; vc:belongsTo tx:T02 ;
    vc:role "후보: 메모리 인터페이스 IP·특허" ;
    vc:points ( "FY2025 총매출 7.076억 달러 중 칩제품 3.478억, 특허·기술 로열티 약 2.794억, 계약·기타 0.804억 달러로 라이선스 성격 합계가 근소하게 우세하고 마진도 높다. 2026년 2분기 제품 0.992억 대 로열티 0.842억+계약 0.240억 달러로 여전히 라이선스 합계가 우세하지만 칩 성장에 따라 L2 재검토가 필요하다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/917273/000119312526321000/rmbs-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-SNPS a vc:Company ;
    rdfs:label "Synopsys Inc." ;
    vc:ticker "SNPS" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US8716071076" .
tx:m-US-SNPS a vc:Membership ;
    vc:company co:US-SNPS ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T02 ; vc:belongsTo tx:T02 ;
    vc:role "후보: 칩 설계·검증 도구" ;
    vc:points ( "FY2026 첫 9개월(2026-07-31) Design Automation 매출 58.266억달러(81.4%)·부문 조정 영업이익 26.416억달러(45% 마진)가 Design IP 매출 13.350억·이익 3.022억보다 크다. DA는 칩 설계·검증 EDA와 하드웨어, 인수한 Ansys의 다산업 시뮬레이션을 포함한다. Ansys의 9개월 기여매출 22억달러는 DA의 약 38%로 커서 순수 반도체 설계도구 L3로 확정하지 않는다. Cadence의 Core EDA 69%, IP 15%, 시스템설계 16%와 설계도구 역할은 유사하지만 Synopsys는 Ansys 인수 후 제품·이익 구조가 더 혼합되어 L3 후보에 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/883241/000088324126000025/snps-20260731.htm"^^xsd:anyURI ;
    vc:source tx:src .

# ━━ T03 반도체 파운드리 ━━

co:US-GFS a vc:Company ;
    rdfs:label "GlobalFoundries Inc." ;
    vc:ticker "GFS" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "KYG393871085" .
tx:m-US-GFS a vc:Membership ;
    vc:company co:US-GFS ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T03 ; vc:belongsTo tx:T03 ;
    vc:role "후보: 특화공정 파운드리" ;
    vc:points ( "GlobalFoundries FY2025 20-F: 고객사 설계 반도체 웨이퍼 제조가 주력이며 2025년 매출 67.91억 달러, 매출총이익 16.90억(24.9%), 영업이익 7.97억(11.7%). 생산 기술은 22/28nm 및 40nm 이상 feature-rich CMOS 외 FD-SOI, RF-SOI, SiGe, RF GaN, BCD, 실리콘 포토닉스까지 광범위하다. TSMC의 선단 로직 74%와 구별되지만 기술별 매출·영업이익은 미공시이고 UMC의 22/28nm, TSEM의 RF·SiPho와 겹쳐 특화공정 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1709048/000170904826000022/gfs-20251231.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-SKYT a vc:Company ;
    rdfs:label "SkyWater Technology Inc." ;
    vc:ticker "SKYT" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US83089J1088" .
tx:m-US-SKYT a vc:Membership ;
    vc:company co:US-SKYT ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T03 ; vc:belongsTo tx:T03 ;
    vc:role "후보: 특화공정 개발·성숙노드 파운드리" ;
    vc:points ( "SkyWater FY2025 10-K와 2026년 2분기 10-Q: 고객용 공정 개발(ATS)과 웨이퍼 위탁제조를 잇는 기술 파운드리. 2026년 상반기 웨이퍼 서비스 매출 1.872억/총 3.171억 달러(59.0%)로 ATS 개발 1.181억(37.3%)을 초과하며, 200mm Fab 25 추가로 제조가 대표 역할. L3는 성숙노드·특화공정 후보. 다만 2026-07-31 IonQ 인수합병 완료로 SKYT 독립 상장·거래 종료(SEC 8-K: https://www.sec.gov/Archives/edgar/data/1819974/000119312526327137/d49031d8k.htm); 원본 유니버스의 역사적 행으로만 유지." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1819974/000181997426000031/skyt-20260628.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-TSEM a vc:Company ;
    rdfs:label "Tower Semiconductor Ltd." ;
    vc:ticker "TSEM" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "IL0010823792" .
tx:m-US-TSEM a vc:Membership ;
    vc:company co:US-TSEM ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T03 ; vc:belongsTo tx:T03 ;
    vc:role "후보: 아날로그·RF·광자 특화 파운드리" ;
    vc:points ( "Tower Semiconductor FY2025 20-F: 팹리스와 IDM에 위탁 웨이퍼 제조를 제공하고 RF CMOS/RF-SOI, SiGe BiCMOS, 실리콘 포토닉스, 전력 IC, 이미지센서 등 특화기술에서 매출의 유의미한 부분을 창출한다고 설명. 2025년 매출 15.661억 달러, 매출총이익률 23.2%, 영업이익률 12.4%. GFS도 RF·SiPho를 취급하나 디지털·전력 등 기술 폭이 더 넓고, TSMC/UMC의 로직 노드 중심 공시와는 사업 초점이 다르다. 특화 기술별 매출과 이익이 미공시여서 광자 단독 분류는 피하고 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/928876/000117891326002318/zk2635149.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-TSM a vc:Company ;
    rdfs:label "Taiwan Semiconductor Manufacturing Company Ltd." ;
    vc:ticker "TSM" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
