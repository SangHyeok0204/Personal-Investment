co:US-IBM a vc:Company ;
    rdfs:label "International Business Machines Corporation" ;
    vc:ticker "IBM" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US4592001014" .
tx:m-US-IBM a vc:Membership ;
    vc:company co:US-IBM ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T11 ; vc:belongsTo tx:T11 ;
    vc:points ( "IBM 2026년 상반기 부문 매출 329.79억달러 중 Software 148.13억(44.9%), Consulting 105.99억, Infrastructure 71.61억, Financing 4.06억. 부문이익은 Software 46.01억으로 전체 부문이익 73.92억의 62.2%, 총이익률 82.7%·부문이익률 31.1%; Consulting 부문이익 12.05억, Infrastructure 13.60억. 소프트웨어 매출은 Hybrid Cloud 39.03억, Automation 36.92억, Data 32.56억, Transaction Processing 39.63억으로 서로 비슷해 단일 세부 제품군이 우세하지 않다. 기업 운영용 플랫폼·데이터·자동화·트랜잭션 SW가 이익의 중심이며 H1 Software 매출 약 80%가 반복 수익이라 인프라소프트웨어·보안 L2. 소프트웨어 제품별 이익이 미공시이고 네 제품군 매출이 분산되어 L3 보류." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/51143/000005114326000078/ibm-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

