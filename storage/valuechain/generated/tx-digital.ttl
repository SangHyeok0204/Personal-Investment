tx:m-US-DELL a vc:Membership ;
    vc:company co:US-DELL ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T08 ; vc:belongsTo tx:T08 ;
    vc:points ( "FY2027 상반기 최신 10-Q에서 Infrastructure Solutions Group 매출 607.91억 달러로 서버·네트워킹·스토리지 시스템을 판매하며, 2분기 단독 매출 317.82억 달러다. Client Solutions Group은 PC·단말을 판매하므로 두 사업 모두 완성형 컴퓨팅 시스템 수익이다. 인프라/PC의 제품·마진 구성이 변하고 있어 단일 L3를 지정하지 않는다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1571996/000157199626000046/dell-20260731.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-HPE a vc:Company ;
    rdfs:label "Hewlett Packard Enterprise Company" ;
    vc:ticker "HPE" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US42824C1099" .
tx:m-US-HPE a vc:Membership ;
    vc:company co:US-HPE ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T08 ; vc:belongsTo tx:T08 ;
    vc:points ( "FY2026 9개월 최신 10-Q에서 Cloud & AI 매출 230.83억 달러가 연결 321.92억의 71.7%, Networking 82.89억 달러가 25.7%다. Cloud & AI는 서버·스토리지 하드웨어와 관련 솔루션을 중심으로 판매하며 Networking은 Juniper 인수로 성장했다. 매출 우위는 컴퓨팅 시스템이지만 부문별 이익률과 제품 조합이 달라 L3를 한 제품군으로 확정하지 않는다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1645590/000164559026000080/hpe-20260731.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-IONQ a vc:Company ;
    rdfs:label "IonQ Inc." ;
    vc:ticker "IONQ" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US46222L1089" .
tx:m-US-IONQ a vc:Membership ;
    vc:company co:US-IONQ ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T08 ; vc:belongsTo tx:T08 ;
    vc:role "후보: 고객 전용 양자연산 시스템 판매" ;
    vc:points ( "IonQ 2026년 상반기 매출 1억4,471.8만달러 중 Quantum hardware 8,217.6만(56.8%), Platform·consulting·support 6,254.2만(43.2%); 2분기도 하드웨어 4,646.7만/총 8,005.0만(58.0%). 회사는 고객 전용 양자 하드웨어 구축·판매 계약 진행과 인수사업이 매출 증가를 이끌었다고 공시하며 클라우드 연산 접근권도 판매한다. 상반기 영업손실 6억880만달러로 아직 손익 기준 세부군 확정은 어렵다. RGTI도 최근 반기 양자시스템·부품 매출 74.9%지만 총이익률 37.4%, 영업손실 5,401만달러로 규모·계약혼합이 다르다. 두 기업의 현재 공통 수익 역할은 전용 컴퓨팅 시스템 판매이며 이온트랩/초전도 기술 방식만으로 L3를 나누지 않는다. 플랫폼·서비스 매출이 43.2%라 다음 공시에서 우위 변화 재검토." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1824920/000119312526341001/ionq-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-LOGI a vc:Company ;
