co:US-NXPI a vc:Company ;
    rdfs:label "NXP Semiconductors N.V." ;
    vc:ticker "NXPI" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "NL0009538784" .
tx:m-US-NXPI a vc:Membership ;
    vc:company co:US-NXPI ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T01 ; vc:belongsTo tx:T01 ;
    vc:role "후보: 차량용 프로세서·혼합신호 칩" ;
    vc:points ( "NXP는 자체 MCU·프로세서·아날로그·네트워킹·보안 IC를 설계하고 자체 공장과 외부 파운드리로 생산해 칩을 판다. FY2025 연결 매출 122.69억달러 중 자동차 최종시장 71.16억(58.0%), 산업·IoT 22.73억(18.5%), 모바일 15.84억(12.9%), 통신인프라·기타 12.96억(10.6%); FY2025 총이익률 54.7%. 2026년 상반기도 자동차 37.20억/전체 66.77억(55.7%), 총이익률 56.8%로 주력은 유지됐다. 자동차향은 단순 테마가 아니라 긴 설계 채택·안전인증·고신뢰성 요건과 차량용 MCU, 네트워킹, 레이더, 혼합신호 제품군이 결합된 시장이다. CRUS의 오디오·혼합신호 칩 FY2026 총이익률 52.8%, SLAB의 저전력 무선 SoC FY2025 58.2%와 같은 칩 판매 역할이나 기능·인증·수요 구조가 다르다. 다만 NXP가 제품 기능별 매출·이익을 공개하지 않아 차량용 제품군 L3는 후보로 둔다. 최신 2026년 2분기 10-Q: https://www.sec.gov/Archives/edgar/data/1413447/000141344726000045/nxpi-20260628.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1413447/000141344726000008/nxpi-20251231.htm"^^xsd:anyURI ;
    vc:source tx:src .

