# ━━ T09 프린팅 시스템·소모품 ━━

co:US-HPQ a vc:Company ;
    rdfs:label "HP Inc." ;
    vc:ticker "HPQ" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
