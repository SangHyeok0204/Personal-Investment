    vc:company co:US-ALRM ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T16 ; vc:belongsTo tx:T16 ;
    vc:points ( "Alarm.com Q2 2026 10-Q: residential and commercial security, video and automation cloud platform sold wholesale through security/installation partners, with per-subscriber monthly SaaS fees and related cameras/sensors. Quarterly SaaS/license revenue $188.778m of total $277.734m (68.0%); SaaS gross margin 84.2% vs hardware/other gross margin 26%. Alarm.com segment generated 87% of total revenue; energy-demand Other segment was secondary. ADT instead contracts directly with end users for monitoring and installation, bearing field service costs. Confirm separate connected-building platform L2; hold L3 because the security/video/automation service mix and profit are not disaggregated." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1459200/000145920026000015/alrm-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

