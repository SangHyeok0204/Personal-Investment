# ━━ T17 도메인 등록·DNS 인프라 ━━

co:US-VRSN a vc:Company ;
    rdfs:label "VeriSign Inc." ;
    vc:ticker "VRSN" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US92343E1029" .
tx:m-US-VRSN a vc:Membership ;
    vc:company co:US-VRSN ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T17 ; vc:belongsTo tx:T17 ;
    vc:role "후보: .com·.net 최상위도메인 레지스트리" ;
    vc:points ( "Verisign FY2025 10-K: ICANN 계약에 따라 .com·.net 최상위도메인 레지스트리와 권한 DNS를 운영하고 등록대행자(registrar)에게 연간 도메인 등록건당 수수료를 수취한다. 소매 도메인 판매자나 인터넷 접속망 사업자가 아니다. 2025년 매출 16.566억 달러, 영업이익 11.210억(영업이익률 67.7%), 연말 .com/.net 등록기반 1.735억 건. 2026년 6월말 등록기반은 1.791억 건으로 지속. ICANN 계약·등록기반·갱신률·허용가격이 경제성의 핵심이며 일반 응용소프트웨어/기업정보 판매와 구분되어 신규 L2가 필요하다. 상장 레지스트리 순수 피어의 비교 손익 근거가 부족해 L3는 후보. 2026H1 근거: https://www.sec.gov/Archives/edgar/data/1014473/000101447326000028/vrsn-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1014473/000101447326000006/vrsn-20251231.htm"^^xsd:anyURI ;
    vc:source tx:src .

# ━━ T18 도메인 등록대행·웹서비스 ━━

co:US-GDDY a vc:Company ;
    rdfs:label "GoDaddy Inc." ;
    vc:ticker "GDDY" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US3802371076" .
tx:m-US-GDDY a vc:Membership ;
    vc:company co:US-GDDY ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T18 ; vc:belongsTo tx:T18 ;
    vc:points ( "GoDaddy 2026년 2분기 10-Q: 최종고객 대상 도메인 등록·갱신·중고도메인·보호, 웹호스팅·보안, 웹사이트 구축·상거래 SW를 판매. 도메인 단독 매출 5.993억/연결 12.980억 달러(46.2%), Core Platform 합계 7.832억(60.3%), Applications & Commerce 5.148억(39.7%). Core Segment EBITDA 2.619억 달러(33.4%)로 A&C 2.411억(46.8%)보다 절대액이 소폭 크고, 연결 영업이익은 3.425억(26.4%). 도메인별 이익은 따로 공개되지 않아 Core 이익 전체를 도메인 이익으로 간주하지 않음. 도메인 소매 등록대행사는 레지스트리 도매·DNS 인프라의 VeriSign과 계약·비용 구조가 다르므로 신규 L2가 적절. 유사 소매 웹서비스 IONOS FY2025 전체 매출 13.169억 유로·조정 EBITDA 4.852억(36.8%)과 사업은 겹치지만 IONOS는 클라우드도 포함하고 GDDY는 도메인 단독 이익을 공시하지 않아 L3 세분화는 보류. IONOS 비교: https://www.ionos-group.com/investor-relations/publications/announcements/ionos-reports-successful-2025-fiscal-year-profitability-at-record-levels.html" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1609711/000160971126000088/gddy-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-WIX a vc:Company ;
    rdfs:label "Wix.com Ltd." ;
    vc:ticker "WIX" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "IL0011301780" .
tx:m-US-WIX a vc:Membership ;
    vc:company co:US-WIX ; vc:sector tx:Sector ;
    vc:primaryCategory tx:T18 ; vc:belongsTo tx:T18 ;
    vc:role "후보: 구독형 웹사이트 제작·운영 플랫폼" ;
    vc:points ( "Wix 2026년 2분기 6-K: 개인·소기업·대행사에 웹사이트·앱 제작 및 운영 플랫폼을 구독으로 제공하고 결제·상거래 기능도 판다. Creative Subscriptions 매출 3.984억/총 5.631억 달러(70.8%), 해당 GAAP 매출총이익률 80%로 추정 총이익 약 3.187억 달러다. Business Solutions 매출 1.647억 달러의 총이익률 32%로 약 0.527억 달러이며, 그 안의 거래 매출은 0.715억 달러다. 연결 GAAP 순손실 0.764억 달러. 따라서 결제 처리보다 사이트 구축·운영 구독이 주력이다. GoDaddy는 같은 최종고객 웹서비스 L2이지만 2026년 2분기 도메인 매출 5.993억 달러가 연결 12.980억 달러의 46.2%, Core Platform 매출 60.3%로 등록대행 중심이다. Wix의 SaaS형 제작/운영과 GoDaddy의 등록대행·호스팅은 계약·원가 구조가 달라 L3 후보로 구분하되 Wix 구독 내 사이트 제작·앱 제작·도메인별 이익 미공시로 확정하지 않는다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1576789/000162828026052108/secondquarter2026results.htm"^^xsd:anyURI ;
    vc:source tx:src .

# ━━ T00 L2 미확정(검증 대기) ━━

co:US-AI a vc:Company ;
