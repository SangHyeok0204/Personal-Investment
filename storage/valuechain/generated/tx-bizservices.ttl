# ━━ B05 공공프로그램 운영대행 ━━

co:US-CXW a vc:Company ;
    rdfs:label "CoreCivic Inc." ;
    vc:ticker "CXW" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US21871N1019" .
tx:m-US-CXW a vc:Membership ;
    vc:company co:US-CXW ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B05 ; vc:belongsTo tx:B05 ;
    vc:role "후보: 교정·구금시설 운영" ;
    vc:points ( "CoreCivic(2021년 REIT 지위 포기)은 2026년 2분기 10-Q에서 부문을 Residential·Services·Properties로 재편했다. 2분기 매출 6.849억 달러 중 Residential(소유·임차 또는 제3자 소유 교정·구금·재진입 시설의 정부 위탁 운영) 6.149억(89.8%), Services(CSP 교정시설 우편약국, TransCor 호송, RMS 전자감독) 8,870만(소거 전 13.0%), Properties(정부에 임대한 5개 시설) 470만(0.7%)이다. 부문 순영업이익 1.490억 중 Residential 1.376억(92.4%), Services 900만, Properties 230만이며 세전이익 4,750만·순이익 3,710만 달러다. 정부 계약 아래 구금·재진입 프로그램을 인원·일수 기준으로 위탁 수행하는 것이 수익계약이므로 Maximus와 같은 공공프로그램 운영대행이며, 64개 시설 중 60개를 소유·장기임차하지만 임대료 사업(Properties)은 1% 미만이라 부동산이 아니다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1070985/000119312526337295/R46.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-GEO a vc:Company ;
    rdfs:label "The Geo Group Inc" ;
    vc:ticker "GEO" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US36162J1060" .
tx:m-US-GEO a vc:Membership ;
    vc:company co:US-GEO ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B05 ; vc:belongsTo tx:B05 ;
    vc:role "후보: 구금·교정시설 운영" ;
    vc:points ( "2026년 2분기 10-Q 매출 7.321억 달러: U.S. Secure Services 5.205억(71.1%), Electronic Monitoring and Supervision 7,616만(10.4%), Reentry Services 7,243만(9.9%), International Services 6,301만(8.6%). 부문 영업이익 1.672억 중 U.S. Secure Services 1.134억(67.8%), 전자감독 3,110만(18.6%), 재진입 1,599만(9.6%), 국제 667만(4.0%). ICE·연방·주정부가 구금시설 운영 계약으로 대가를 지급하며 CoreCivic 선례에 따라 공공프로그램 운영대행이고 시설 소유는 임대사업이 아니다. 상장명에 REIT가 남아 있으나 2021년 REIT 지위를 해제한 일반법인이다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/923796/000119312526337932/R68.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-LRN a vc:Company ;
    rdfs:label "Stride Inc." ;
    vc:ticker "LRN" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US86333M1080" .
tx:m-US-LRN a vc:Membership ;
    vc:company co:US-LRN ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B05 ; vc:belongsTo tx:B05 ;
    vc:role "후보: K-12 온라인 공립학교 운영대행" ;
    vc:points ( "FY2026(2026년 6월 결산) 10-K: 매출 25억1,810만 달러 중 General Education 14억1,780만(56.3%)·Career Learning 중고교 10억4,370만(41.5%)·성인 5,660만(2.2%), 영업이익 4억5,080만 달러(17.9%), 단일 부문. 매출 대부분은 차터보드·학군과의 school-as-a-service 계약(교육과정·기술·교사·지원 일괄 운영)이고 계약 상대 공립학교는 연방·주·지방 세금으로 재원을 조달하며 학생당(per-pupil) 공적 지원금에 연동된다. 가계가 아닌 정부 재원이 지불자이므로 민간 교육이 아닌 공공 교육프로그램 운영 위탁으로 본다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1157408/000110465926090515/lrn-20260630x10k.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-MMS a vc:Company ;
    rdfs:label "Maximus Inc." ;
    vc:ticker "MMS" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US5779331041" .
tx:m-US-MMS a vc:Membership ;
    vc:company co:US-MMS ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B05 ; vc:belongsTo tx:B05 ;
    vc:role "후보: 복지·건강 프로그램 운영·평가" ;
    vc:points ( "Maximus FY2026 6월 종료 9개월 매출 39.300억달러 중 정부 프로그램 운영 19.241억(49.0%), 임상서비스 16.076억(40.9%), 고용·기타 1.860억(4.7%), 기술솔루션 2.123억(5.4%)이다. 성과기준 계약이 22.096억(56.2%), 원가가산 10.338억(26.3%)으로, SAIC의 60.9% 원가보상·CACI의 56.0% 원가가산 중심 국방 임무 IT 통합과 다른 수량·평가 성과형 손익이다. 미국 연방 부문은 매출 22.607억달러(57.5%), 영업이익 3.965억달러(부문합계의 78.3%, 해당부문 영업이익률 17.5%)로 가장 크다. 시민의 건강·복지 혜택 신청, 자격·임상 평가, 연락센터 등 정부 프로그램 운영 계약이 주력이고 기술 IP 자체 판매나 의료비 위험 인수가 아니다. 프로그램 운영과 임상평가가 모두 상당해 L3의 정확한 주력 세부군은 후보로 둔다. 기존 IT 구축·아웃소싱보다 새 L2 공공프로그램 운영대행이 적합하므로 레지스트리 추가 검토 필요. 매출유형·계약: https://www.sec.gov/Archives/edgar/data/1032220/000103222026000035/R24.htm ; 비교: https://www.sec.gov/Archives/edgar/data/1571123/000157112326000133/saic-20260731.htm ; https://www.sec.gov/Archives/edgar/data/16058/000162828026054195/caci-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1032220/000103222026000035/mms-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

