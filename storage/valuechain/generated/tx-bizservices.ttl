    vc:isin "US31846B1089" .
tx:m-US-FA a vc:Membership ;
    vc:company co:US-FA ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B11 ; vc:belongsTo tx:B11 ;
    vc:role "후보: 고용 신원조회·검증" ;
    vc:points ( "First Advantage 2026년 2분기 10-Q: 고용주에게 범죄·학력·경력·면허 등의 채용 전 신원조회와 재직 중 지속 모니터링 보고서를 제공한다. 회사는 채용 전 조회가 매출의 상당한 대부분이라고 설명하며, 주문을 완료해 보고서를 제공할 때 거의 모든 매출을 인식한다. 상반기 매출 8.340억 달러, 2분기 매출 4.488억 달러·순이익 0.169억 달러다. 직원 파견이나 채용 중개보다 검증된 인력 정보를 판매하는 역할이므로 기업 데이터·정보서비스에 둔다. Sterling 인수 후 세 지역·법인 부문은 같은 신원조회 서비스를 제공하며 제품별 이익이 공시되지 않아 L3는 후보로 둔다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1210677/000119312526338063/fa-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

