# ━━ B03 급여·인사 운영대행 ━━

co:US-ADP a vc:Company ;
    rdfs:label "Automatic Data Processing Inc." ;
    vc:ticker "ADP" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US0530151036" .
tx:m-US-ADP a vc:Membership ;
    vc:company co:US-ADP ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B03 ; vc:belongsTo tx:B03 ;
    vc:points ( "FY2026(2026-06-30) Employer Services는 급여처리·복리후생·인사관리 및 비PEO 인사 아웃소싱을 고객에게 수행하며 부문매출 148.314억달러, 세전이익 54.368억달러다. 공동고용 PEO는 매출 71.281억달러 중 이익 없는 복리후생 통과액 46.073억달러, 세전이익 9.361억달러다. HCM/Global 수익은 처리·구현·관리 서비스 계약과 결합되고 고객자금 이자 13.548억달러도 전체 수익에 포함된다. 대표 역할은 PEO의 고용위험 인수나 앱 사용권 단독 판매보다 반복 급여·인사 운영대행이다. Paychex도 급여처리·인사관리 서비스와 PEO를 함께 파나 PEO 비중·고객 범위가 다르며, 급여/복리후생 내 개별 손익 미공시라 L3를 보류한다." ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/8670/000000867026000030/adp-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

co:US-PAYX a vc:Company ;
