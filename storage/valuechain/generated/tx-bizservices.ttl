# ━━ B01 IT 제품 유통·솔루션 ━━

co:US-CDW a vc:Company ;
    rdfs:label "CDW Corporation" ;
    vc:ticker "CDW" ; vc:exchange "US" ; vc:country "US" ; vc:listed true ;
    vc:isin "US12514G1085" .
tx:m-US-CDW a vc:Membership ;
    vc:company co:US-CDW ; vc:sector tx:Sector ;
    vc:primaryCategory tx:B01 ; vc:belongsTo tx:B01 ;
    vc:role "후보: 기업 최종고객 IT 재판매·구축" ;
    vc:points ( "CDW 2026년 2분기 10-Q: 다양한 제조사에서 조달한 IT 하드웨어·소프트웨어를 기업·정부·교육·의료 고객에게 유통하며 구축·지원 서비스를 결합한다. 상반기 매출 122.520억 달러 중 하드웨어 90.199억(73.6%), 소프트웨어 21.692억(17.7%), 서비스 10.012억(8.2%)이다. 자체 컴퓨팅 제품 제조나 SW IP 판매가 아니라 벤더 중립적 재판매·솔루션 제공이 수익 역할이다. 유사한 Insight Enterprises는 2026년 2분기 제품 재판매와 서비스 결합으로 총이익률 21.7%, CDW는 약 20.1%여서 IT 유통·솔루션 비교군이 성립한다. 현행 레지스트리의 IT 구축·아웃소싱은 인력·프로젝트·운영 계약, 산업재 유통·설비서비스는 기계·MRO 중심이므로 어느 L2도 CDW의 주력인 다품목 IT 재판매를 정확히 담지 못한다. 공시의 제품 재판매 비중과 자체 제품·IP 비소유에 따라 기업서비스 > IT 제품 유통·솔루션으로 배정한다. 유통 단계와 높은 총이익률을 근거로 기업 최종고객 재판매 L3를 후보로 두며, 순수 채널 도매와의 비교를 계속한다. Insight 10-Q: https://www.sec.gov/Archives/edgar/data/932696/000093269626000070/nsit-20260630.htm" ) ;
    vc:url "https://www.sec.gov/Archives/edgar/data/1402057/000140205726000065/cdw-20260630.htm"^^xsd:anyURI ;
    vc:source tx:src .

